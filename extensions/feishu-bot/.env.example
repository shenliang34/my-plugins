# 复制本文件为 ~/.pi/agent/feishu-bot.env 并填写（推荐），
# 或放到本扩展目录下改名为 .env（仅本地开发）。
# 注意：.env 含密钥，切勿提交到 git。

# ============ 飞书应用凭证（必填） ============
# 在飞书开放平台 open.feishu.cn 的「开发者后台 -> 凭证与基础信息」获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Pi Agent 配置 ============
# 默认工作目录（Agent 在这里执行 read/bash/edit/write 等操作）
PI_DEFAULT_CWD=C:/Users/12280

# 会话持久化目录（可选，默认 ~/.pi/agent/feishu-sessions，每个飞书会话一个子目录）
# PI_SESSIONS_DIR=C:/Users/12280/.pi/agent/feishu-sessions

# 是否在飞书中显示工具调用进度（默认 true）
# PI_SHOW_TOOL_STATUS=true

# 是否随 pi 启动自动运行机器人（默认 false，建议手动 /feishu start）
# FEISHU_AUTO_START=false

# ============ 安全配置 ============
# 允许使用机器人的单聊用户 ID（open_id 或 user_id），逗号分隔。
# 留空 = 允许所有单聊用户（⚠️ 机器人可执行本机命令，请谨慎）。
# FEISHU_ALLOWED_DM_USERS=ou_xxxx,ou_yyyy

# 允许使用机器人的群 chat_id，逗号分隔。留空 = 允许所有群。
# FEISHU_ALLOWED_GROUPS=oc_xxxx

# 群聊中是否需要 @ 机器人才响应（默认 true）
FEISHU_REQUIRE_MENTION=true

# 日志级别：fatal/error/warn/info/debug/trace（默认 info）
# FEISHU_LOG_LEVEL=info
